{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/restaurant-ai/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
